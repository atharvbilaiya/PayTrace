# PayTrace Backend Environment Variables Example
# Copy this file to .env or set these variables in your hosting platform (Render / Railway)

# Port to run the FastAPI Uvicorn server (assigned automatically by Render / Railway)
PORT=8000

# Comma-separated allowed CORS origins for production deployment
# Example: CORS_ORIGINS=http://localhost:5173,https://paytrace-frontend.vercel.app
CORS_ORIGINS=*
